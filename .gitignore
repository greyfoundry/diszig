# Local work, reference sources, internal reports, bootstrap material
/.private/
/.local/
**/.zig-cache/
**/zig-out/
**/node_modules/
**/.turbo/
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/coverage/
**/test-results/
# The root coverage manifest is evidence, not generated coverage output.
!/coverage/
!/coverage/**
**/.DS_Store
/.claude/settings.local.json
/.cursor/local/
/.vscode/*.local.json

**/__pycache__/
**/*.pyc

# Publish project instructions, skills and handbook despite user-wide ignores.
!/docs/
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/.agents/
/.agents/*
!/.agents/skills/
!/.agents/skills/**
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/skills/**
!/.cursor/
/.cursor/*
!/.cursor/rules/
!/.cursor/rules/**
