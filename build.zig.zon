.{
    .name = .diszig,
    .version = "0.0.0",
    .fingerprint = 0xf1803f32383d74e9,
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // Required for incremental `zlib-stream` inflate. Pinned to the
        // official release asset: GitHub's auto-generated archive tarballs are
        // not byte-stable across time, while uploaded release assets are.
        .zlib = .{
            .url = "https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz",
            .lazy = true,
            .hash = "N-V-__8AAJ2cNgAgfBtAw33Bxfu1IWISDeKKSr3DAqoAysIJ",
        },
        // Deliberately no voice dependency. Optional voice is unavailable and
        // links nothing; libdave and Opus require provenance, hash and ABI
        // review first. See .private/reports/decisions/voice.md.
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "packages",
        "examples",
        // Scope to the vendored websocket only: fetched libdave artifacts under
        // third_party/libdave are not part of the source package.
        "third_party/websocket",
        "tools/fetch_libdave.py",
        "tools/fetch_opus.py",
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md",
        "README.md",
    },
}

